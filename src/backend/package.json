{
  "name": "surveillanceos-backend",
  "version": "1.0.0",
  "description": "SurveillanceOS Fastify API server — cameras, auth, stream proxy",
  "type": "module",
  "scripts": {
    "dev":       "tsx watch src/index.ts",
    "start":     "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test:backend": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "prisma migrate dev",
    "db:seed":    "tsx prisma/seed.ts",
    "db:generate":"prisma generate"
  },
  "dependencies": {
    "@fastify/cors":       "^9.0.1",
    "@fastify/helmet":     "^12.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static":     "^8.0.3",
    "@prisma/client":      "^6.0.0",
    "bcryptjs":            "^2.4.3",
    "bullmq":              "^5.7.0",
    "fastify":             "^4.28.1",
    "fastify-plugin":      "^4.5.1",
    "fluent-ffmpeg":       "^2.1.3",
    "jsonwebtoken":        "^9.0.2",
    "pino":                "^9.0.0",
    "prom-client":         "^15.1.3",
    "uuid":                "^10.0.0",
    "zod":                 "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs":       "^2.4.6",
    "@types/fluent-ffmpeg":  "^2.1.27",
    "@types/jsonwebtoken":   "^9.0.7",
    "@types/node":           "^22.0.0",
    "@types/uuid":           "^10.0.0",
    "prisma":                "^6.0.0",
    "tsx":                   "^4.19.2",
    "typescript":            "^5.7.3",
    "vitest":                "^2.1.9"
  },
  "engines": { "node": ">=22.0.0" }
}
