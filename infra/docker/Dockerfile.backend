# ── Stage 1: deps ─────────────────────────────────────────────────────────────
FROM node:22-alpine AS base

WORKDIR /app

# Install production deps only (package-lock.json is required for ci)
COPY src/backend/package*.json ./
RUN npm ci --only=production

# ── Stage 2: production image ─────────────────────────────────────────────────
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Copy production node_modules from base stage
COPY --from=base /app/node_modules ./node_modules

# Copy compiled TypeScript output (built by `npm run build` before docker build)
COPY src/backend/dist ./dist

# Copy prisma schema so the Prisma client can find it at runtime
COPY src/backend/prisma ./prisma

EXPOSE 3001

CMD ["node", "dist/index.js"]
